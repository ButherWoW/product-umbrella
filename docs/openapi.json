{
  "openapi": "3.1.0",
  "info": { "title": "Product Umbrella API", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
  "paths": {
    "/health": { "get": { "summary": "Health check", "responses": { "200": { "$ref": "#/components/responses/Ok" } } } },
    "/r/{campaign}": { "get": { "summary": "Stream redirect", "parameters": [{ "$ref": "#/components/parameters/Campaign" }], "responses": { "302": { "description": "Redirect" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/r/{campaign}/{offer}": { "get": { "summary": "Direct offer redirect", "parameters": [{ "$ref": "#/components/parameters/Campaign" }, { "$ref": "#/components/parameters/Offer" }], "responses": { "302": { "description": "Redirect" } } } },
    "/lp/click": { "get": { "summary": "Landing click", "responses": { "302": { "description": "Redirect" } } } },
    "/postback": { "get": { "summary": "Conversion postback", "responses": { "200": { "$ref": "#/components/responses/Ok" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/stats": { "get": { "summary": "Aggregate statistics", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/stats/compare": { "get": { "summary": "Compare periods", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/stats/timeseries": { "get": { "summary": "Time series", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/stats/params": { "get": { "summary": "Parameter report", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/stats/export": { "get": { "summary": "CSV export", "responses": { "200": { "description": "CSV" } } } },
    "/stats/bots": { "get": { "summary": "Bot statistics", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/campaigns": { "get": { "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/api/campaigns/{id}": { "patch": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/campaigns/{id}/clone": { "post": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/api/offers": { "get": { "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/api/offers/{id}": { "patch": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/offers/{id}/clone": { "post": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/api/sources": { "get": { "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/api/sources/{id}": { "patch": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/networks": { "get": { "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/api/networks/{id}": { "patch": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/clicks": { "get": { "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/conversions": { "get": { "responses": { "200": { "$ref": "#/components/responses/Json" } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" }, "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "umb_session" } },
    "parameters": { "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }, "Campaign": { "name": "campaign", "in": "path", "required": true, "schema": { "type": "string" } }, "Offer": { "name": "offer", "in": "path", "required": true, "schema": { "type": "string" } } },
    "responses": { "Ok": { "description": "Success", "content": { "application/json": { "schema": { "type": "object" } } } }, "Json": { "description": "JSON response", "content": { "application/json": { "schema": { "type": "object" } } } }, "Error": { "description": "Error", "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "string" } } } } } } }
  }
}
