[Unit]
Description=Product Umbrella tracker
After=network.target

[Service]
Type=simple
User=umbrella
Group=umbrella
WorkingDirectory=/opt/umbrella/app
EnvironmentFile=/opt/umbrella/.env
ExecStart=/usr/bin/env node src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/umbrella/data
PrivateTmp=true
# New data files (journal, JSON stores, logs) are owner-only; nginx serves no files from /opt/umbrella/data.
UMask=0077

[Install]
WantedBy=multi-user.target
