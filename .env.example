# Переменные окружения Product Umbrella. Скопируйте в .env и заполните.
# Строки с «# ИМЯ=…» — необязательные, в комментарии значение по умолчанию или пример.
# test/env-example.test.mjs проверяет, что здесь перечислена каждая переменная из src/, deploy/ и scripts/.

# ── Сервер ────────────────────────────────────────────────────────────────
PORT=4100
# Префикс пути, если панель отдаётся из подкаталога за прокси (production: /umbrella). Только [A-Za-z0-9_-].
# BASE_PATH=/umbrella
# Каталог данных: JSONL-журнал событий, настройки, пользователи без PostgreSQL. По умолчанию ./data.
# DATA_DIR=/opt/umbrella/data
# Основной домен панели; остальные домены считаются доменами трекинга (панель на них не открывается).
# PRIMARY_HOST=nespizdili.lol
# 1 — отдавать файлы панели из build/panel/ (запутанный JS, без комментариев; делает scripts/obfuscate-panel.mjs).
# В production включено деплоем; локально не нужно.
# PANEL_BUILD=1
# Лог сервиса в файл (дублирует stdout) и его предельный размер в МБ, после которого файл ротируется.
# LOG_FILE=/opt/umbrella/data/umbrella.log
# LOG_MAX_MB=50

# ── Доступ и безопасность ─────────────────────────────────────────────────
# 1 = отчёты и API только после входа (в production обязательно).
REQUIRE_LOGIN=1
# Bearer-токен администратора для API и скриптов (длинная случайная строка, не совпадает с POSTBACK_SECRET).
ADMIN_TOKEN=replace-with-a-different-long-random-token
# Файл переопределений, который деплой не трогает (деплой пересоздаёт .env целиком). По умолчанию .env.local на уровень выше DATA_DIR
# (/opt/umbrella/.env.local), формат KEY=value; значения из него сильнее .env. off — не читать.
# ENV_LOCAL_FILE=/opt/umbrella/.env.local
# Секрет постбэка: партнёрка добавляет &secret=… к /postback.
POSTBACK_SECRET=replace-with-a-long-random-secret
# Число своих прокси перед сервером (1 или true за nginx). Без него X-Forwarded-For игнорируется.
TRUST_PROXY=1
# Cookie сессии только по HTTPS. За прокси с TRUST_PROXY включается сама по X-Forwarded-Proto.
# COOKIE_SECURE=1
# Панель, /api и /stats только с этих IP / IPv4 CIDR (через запятую). Трекинг остаётся публичным. За прокси нужен TRUST_PROXY.
# ADMIN_ALLOWED_IPS=203.0.113.7,198.51.100.0/24
# Лимит кликов с одного IP за окно (мс); сверх лимита — 429.
CLICK_RATE_LIMIT=120
CLICK_RATE_WINDOW_MS=60000
# Отдельные лимиты на IP для /lp/click и /postback (0 — выключить).
# LP_CLICK_RATE_LIMIT=300
# LP_CLICK_RATE_WINDOW_MS=60000
# POSTBACK_RATE_LIMIT=1200
# POSTBACK_RATE_WINDOW_MS=60000
# Лимиты попыток входа за окно (15 мин): пара email+IP, один email с любых IP, один IP.
# LOGIN_WINDOW_MS=900000
# LOGIN_LIMIT_PER_EMAIL_IP=10
# LOGIN_LIMIT_PER_EMAIL=30
# LOGIN_LIMIT_PER_IP=50

# ── Хранилище ─────────────────────────────────────────────────────────────
# Без DATABASE_URL всё хранится в JSONL в DATA_DIR.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/product_umbrella
# 1 = не стартовать без PostgreSQL (не переключаться молча на JSONL). В production обязательно.
REQUIRE_POSTGRES=1
# Хранить клики без конверсии, ботов и журнал постбэков N дней (очистка раз в сутки; конверсии — бессрочно). Не задано — бессрочно.
# RETENTION_DAYS=90
# Задержка первой очистки после старта, мс.
# RETENTION_DELAY_MS=60000
# Сверка PostgreSQL с журналом: полная через RECONCILE_DELAY_MS после старта, затем новые события каждые RECONCILE_INTERVAL_MS (0 — выключить).
# RECONCILE_DELAY_MS=5000
# RECONCILE_INTERVAL_MS=900000

# ── Трекинг ───────────────────────────────────────────────────────────────
# Сколько последних кликов (для /lp/click и постбэков) и посетителей кампания+IP (для дедупликации) держать в памяти;
# более старые читаются из журнала.
# CLICK_INDEX_LIMIT=200000
# Как часто счётчики капов кликов сверяются с базой/журналом, мс.
# CAP_REFRESH_MS=60000
# URL демо-оффера offer-1, который создаётся при первом запуске.
OFFER_1_URL=https://example.com/
# Базы DB-IP / MaxMind в формате .mmdb: страна и ASN (провайдер, тип соединения). Без них гео- и ISP-условия не срабатывают.
# GEOIP_DB=/opt/umbrella/geo/country.mmdb
# GEOIP_ASN_DB=/opt/umbrella/geo/asn.mmdb
# Валюта отчётов (ISO 4217) и обновление курсов: FX_REFRESH=0 — не обновлять (каждые 12 ч по умолчанию).
# DEFAULT_CURRENCY=EUR
# FX_REFRESH=0
# Пауза между повторами исходящего S2S-постбэка, мс (×номер попытки, всего 3 попытки).
# S2S_RETRY_MS=2000
# 1 = постбэк в источник трафика может уходить на loopback и http (только для тестов; включает и S2S_ALLOW_PRIVATE).
# SOURCE_POSTBACK_ALLOW_PRIVATE=1
# 1 = S2S-постбэк оффера может уходить на loopback (только для тестов).
# S2S_ALLOW_PRIVATE=1

# ── Мониторинг офферов и лендингов ────────────────────────────────────────
# MONITOR=0 выключает таймер (ручная проверка POST /api/monitor/check работает).
# MONITOR=1
# MONITOR_INTERVAL_MS=600000
# Частные IP, которые всё же можно проверять (через запятую) — только для тестов против 127.0.0.1.
# MONITOR_ALLOW_PRIVATE=127.0.0.1

# ── Скрипты импорта из Keitaro (scripts/import-keitaro-*.mjs) ────────────
# KEITARO_URL=https://whynot.partners
# UMBRELLA_URL=https://nespizdili.lol/umbrella
# Секреты — из переменной или из файла в домашнем каталоге (~/.keitaro-api-key, ~/umbrella-admin-token.txt).
# KEITARO_API_KEY=
# UMBRELLA_TOKEN=

# ── Деплой и бэкапы на сервере (deploy/*.sh; в .env приложения не нужны) ──
# Значения по умолчанию подходят для прода; переопределяются в deploy/test-release-switch.sh.
# Корень установки (releases/, app → текущий релиз, backups/).
# UMBRELLA_ROOT=/opt/umbrella
# Куда release.sh ставит unit-файлы systemd.
# SYSTEMD_DIR=/etc/systemd/system
# Проверка здоровья после переключения релиза: адрес и число попыток (по 1 с), иначе откат.
# HEALTH_URL=http://127.0.0.1:4110/health
# HEALTH_TRIES=20
# Сколько хранить релизов и дампов перед деплоем.
# KEEP_RELEASES=3
# KEEP_DUMPS=5
# deploy/backup.sh (ночной таймер): сколько дней хранить бэкапы.
# KEEP_DAYS=14

# ── Только для тестов ─────────────────────────────────────────────────────
# Отдельная тестовая база для test/postgres*.test.mjs (её таблицы очищаются).
# TEST_DATABASE_URL=postgresql://umbrella:local@127.0.0.1:55432/umbrella
# Путь к playwright/index.mjs, если Playwright не установлен в проект (браузерные тесты test/ui/).
# PLAYWRIGHT_MODULE=/path/to/node_modules/playwright/index.mjs
